<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CodeSugar</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>    
  </PropertyGroup>  

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <EnableMicrosoftTestingPlatformExtension>true</EnableMicrosoftTestingPlatformExtension>
  </PropertyGroup>

  <ItemGroup>    
    <PackageReference Include="TUnit" />		
    <PackageReference Include="TestAttachments.TUnit" />
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="System.IO.Hashing" />		
		<PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
		<PackageReference Include="SharpCompress" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
  </ItemGroup>

  <Choose>
    <When Condition="false">
      <ItemGroup>
        <ProjectReference Include="..\..\src\CodeSugar.IO.Templates\CodeSugar.IO.Templates.csproj" />
      </ItemGroup>      
    </When>
    <Otherwise>
      <ItemGroup>
        <ProjectReference Include="..\..\src\CodeSugar.IO.SourceGenerator\CodeSugar.IO.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
      </ItemGroup>
    </Otherwise>    
  </Choose>

</Project>
