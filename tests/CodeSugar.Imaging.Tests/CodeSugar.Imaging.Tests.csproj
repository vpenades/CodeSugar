<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>CodeSugar</RootNamespace>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<PublishAot>true</PublishAot>
	</PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\gencode</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit" />		
		<PackageReference Include="TestAttachments.TUnit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Numerics.Tensors" />
		<PackageReference Include="SixLabors.ImageSharp" NoWarn="NU1901;NU1902;NU1903;NU1904" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" NoWarn="NU1901;NU1902;NU1903;NU1904" />
		<PackageReference Include="PhotoSauce.MagicScaler" />
		<PackageReference Include="SkiaSharp" />
    <PackageReference Include="Avalonia" />		
	</ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <PackageReference Include="InteropTypes.TensorBitmaps.Core" />
  </ItemGroup>

	<Choose>
		<When Condition="false">
			<ItemGroup>
				<ProjectReference Include="..\..\src\CodeSugar.IO.Templates\CodeSugar.IO.Templates.csproj" />
				<ProjectReference Include="..\..\src\CodeSugar.Imaging.Templates\CodeSugar.Imaging.Templates.csproj" />
				<ProjectReference Include="..\..\src\CodeSugar.Numerics.Templates\CodeSugar.Numerics.Templates.csproj" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<ProjectReference Include="..\..\src\CodeSugar.IO.SourceGenerator\CodeSugar.IO.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
				<ProjectReference Include="..\..\src\CodeSugar.Imaging.SourceGenerator\CodeSugar.Imaging.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
				<ProjectReference Include="..\..\src\CodeSugar.Numerics.SourceGenerator\CodeSugar.Numerics.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
			</ItemGroup>
		</Otherwise>
	</Choose>

</Project>
