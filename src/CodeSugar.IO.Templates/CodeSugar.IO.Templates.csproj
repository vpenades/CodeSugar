<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>		
    <TargetFrameworks>netstandard2.1;net8.0;net10.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>

  <Import Project="..\Template.props" />

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);__REFERENCES_SYSTEMTEXTJSON</DefineConstants>
		<DefineConstants>$(DefineConstants);__REFERENCES_MICROSOFTEXTENSIONSFILEPROVIDERSABSTRACTIONS</DefineConstants>
		<DefineConstants>$(DefineConstants);__REFERENCES_MICROSOFTIORECYCLABLEMEMORYSTREAM</DefineConstants>
		<DefineConstants>$(DefineConstants);__REFERENCES_SHARPCOMPRESS</DefineConstants>
    <DefineConstants>$(DefineConstants);__REFERENCES_SYSTEMIOHASHING</DefineConstants>
		<DefineConstants>$(DefineConstants);__REFERENCES_AVALONIA</DefineConstants>
  </PropertyGroup>  

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    <PackageReference Include="SharpCompress" />
		<PackageReference Include="Avalonia" />
  </ItemGroup>  

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
		<PackageReference Include="System.Text.Json" />		
	</ItemGroup>

</Project>
